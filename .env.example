# CanopyChain reads settings per part, not from this root file. Copy the lines you need into:
#   contracts/.env        (deploying the contract)
#   backend/.env          (oracle + API)
#   frontend/.env.local   (dApp)
# All three are gitignored. Testnet keys only. Full lists: backend/README.md and frontend/README.md.

# --- contracts/.env ---
DEPLOYER_PRIVATE_KEY=
ORACLE_ADDRESS=
ETHERSCAN_API_KEY=
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com

# --- backend/.env ---
ORACLE_PRIVATE_KEY=
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# PUBLIC_BASE_URL=https://your-backend.onrender.com
# CANOPY_CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app
# CANOPY_APPROVERS=
# CANOPY_DEMO_CONTROLS=1

# --- frontend/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
